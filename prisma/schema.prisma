generator client {
  provider      = "prisma-client-js"
  // native = الجهاز الحالي، والتاني = Docker (Alpine)
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// أدوار المستخدمين
enum Role {
  ADMIN // مدير النظام: كل الصلاحيات
  MANAGER // مدير قسم: يتحكم في قسمه
  EMPLOYEE // موظف
}

// أقسام الشركة
enum Department {
  EMPLOYEES // الموظفين
  CLIENTS // العملاء
  REQUESTS // الطلبات
  ADMIN_AFFAIRS // الشؤون الإدارية
  ACCOUNTS // الحسابات
  PR // العلاقات العامة
}

model User {
  id           String      @id @default(cuid())
  name         String
  email        String      @unique
  passwordHash String
  role         Role        @default(EMPLOYEE)
  department   Department?
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  assignedTransactions Transaction[]       @relation("Assignee")
  createdTransactions  Transaction[]       @relation("Creator")
  transactionEvents    TransactionEvent[]
  uploadedDocuments    Document[]
  permissions          Permission[]
  employee             Employee?
  mustChangePassword   Boolean             @default(false) // لازم يغيّر كلمة المرور أول دخول
  managedClients       Client[]            @relation("ClientManager")
  submittedRequests    LeaveRequest[]      @relation("RequestCreator")
  decidedRequests      LeaveRequest[]      @relation("RequestDecider")
  editedAttendance     Attendance[]
  payrollRunsCreated   PayrollRun[]        @relation("RunCreator")
  payrollRunsApproved  PayrollRun[]        @relation("RunApprover")
  reviewsGiven         PerformanceReview[]
  createdContracts     Contract[]
  interactions         Interaction[]       @relation("InteractionCreator")
  followUps            Interaction[]       @relation("FollowUpAssignee")
  createdQuotes        Quote[]
  deliveries           Delivery[]          @relation("DeliveredBy")
  // التوزيع التلقائي للمعاملات
  autoAssign           Boolean             @default(false) // مدرج في التوزيع التلقائي
  assignableServices   ServiceType[]       @relation("AssignableServices") // فارغة = كل الخدمات
  acceptances          TxAcceptance[]
  eventTargets         TransactionEvent[]  @relation("EventTarget")
  extensionRequests    ExtensionRequest[]  @relation("ExtensionRequester")
  extensionDecisions   ExtensionRequest[]  @relation("ExtensionDecider")
  lettersCreated       Letter[]            @relation("LetterCreator")
  lettersReviewed      Letter[]            @relation("LetterReviewer")
  lettersApproved      Letter[]            @relation("LetterApprover")
  lettersAssigned      Letter[]            @relation("LetterAssignee")
  letterEvents         LetterEvent[]
  assetsCreated        Asset[]             @relation("AssetCreator")
  custodiesAssigned    Custody[]           @relation("CustodyAssigner")
  custodiesReceived    Custody[]           @relation("CustodyReceiver")
  purchaseRequests     PurchaseRequest[]   @relation("PurchaseRequester")
  purchaseManagerOks   PurchaseRequest[]   @relation("PurchaseManager")
  purchaseApprovals    PurchaseRequest[]   @relation("PurchaseApprover")
  purchaseReceipts     PurchaseRequest[]   @relation("PurchaseReceiver")
  purchaseEvents       PurchaseEvent[]
}

// ======================= العملاء والشركات =======================

// العميل (فرد)
enum ClientStatus {
  LEAD // عميل محتمل
  ACTIVE // نشط
  INACTIVE // متوقف
}

model Client {
  id               String        @id @default(cuid())
  name             String
  nationalId       String?       @unique // رقم الهوية / الإقامة
  phone            String?
  phone2           String?
  email            String?
  nationality      String?
  city             String?
  status           ClientStatus  @default(ACTIVE)
  vip              Boolean       @default(false) // عميل مميز
  source           String? // جالنا منين (توصية، سوشيال ميديا...)
  accountManager   User?         @relation("ClientManager", fields: [accountManagerId], references: [id])
  accountManagerId String? // الموظف المسؤول عن العميل
  notes            String?
  archivedAt       DateTime? // العميل المؤرشف بيختفي من القوايم من غير ما يتمسح
  companies        Company[]
  documents        Document[]
  contracts        Contract[]
  interactions     Interaction[]
  quotes           Quote[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  letters          Letter[]
}

// شركة يملكها العميل
model Company {
  id              String        @id @default(cuid())
  client          Client        @relation(fields: [clientId], references: [id])
  clientId        String
  name            String
  crNumber        String?       @unique // رقم السجل التجاري
  unifiedNumber   String?       @unique // الرقم الموحد (700)
  legalForm       String? // الكيان القانوني
  city            String?
  activity        String? // النشاط
  crExpiry        DateTime? // تاريخ انتهاء السجل
  vatNumber       String? // الرقم الضريبي (15 رقم)
  nationalAddress String? // العنوان الوطني المختصر
  molFileNumber   String? // رقم ملف مكتب العمل
  gosiNumber      String? // رقم الاشتراك في التأمينات
  nitaqat         String? // نطاق المنشأة
  saudiCount      Int? // عدد الموظفين السعوديين
  nonSaudiCount   Int? // عدد غير السعوديين
  notes           String?
  transactions    Transaction[]
  documents       Document[]
  contracts       Contract[]
  interactions    Interaction[]
  quotes          Quote[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([clientId])
}

// ======================= القوائم القابلة للتعديل =======================

// نوع الخدمة (ترخيص صناعي، تأسيس شركة...)
model ServiceType {
  id              String        @id @default(cuid())
  name            String
  govEntity       GovEntity?    @relation(fields: [govEntityId], references: [id])
  govEntityId     String? // الجهة اللي الخدمة دي تبعها (فاضي = خدمة عامة)
  order           Int           @default(0)
  active          Boolean       @default(true)
  transactions    Transaction[]
  quoteItems      QuoteItem[]
  autoAssignUsers User[]        @relation("AssignableServices")

  @@unique([name, govEntityId])
  @@index([govEntityId])
}

// الجهة / المنصة الحكومية (قوى، تقييم، وزارة التجارة...)
model GovEntity {
  id           String        @id @default(cuid())
  name         String        @unique
  order        Int           @default(0)
  active       Boolean       @default(true)
  services     ServiceType[]
  transactions Transaction[]
}

enum StageKind {
  OPEN // مرحلة جارية
  DONE // مكتملة
  CANCELLED // ملغاة / مرفوضة
}

// مراحل المعاملة بالترتيب
model Stage {
  id               String             @id @default(cuid())
  name             String             @unique
  order            Int                @default(0)
  kind             StageKind          @default(OPEN)
  active           Boolean            @default(true)
  readyForDelivery Boolean            @default(false) // المخرجات صدرت وتنتظر التسليم للعميل
  transactions     Transaction[]
  events           TransactionEvent[]
}

// ======================= المعاملات =======================

model Transaction {
  id                String             @id @default(cuid())
  number            Int                @unique @default(autoincrement()) // رقم المعاملة
  title             String
  description       String?
  company           Company            @relation(fields: [companyId], references: [id])
  companyId         String
  serviceType       ServiceType?       @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId     String?
  govEntity         GovEntity?         @relation(fields: [govEntityId], references: [id])
  govEntityId       String?
  stage             Stage              @relation(fields: [stageId], references: [id])
  stageId           String
  assignee          User?              @relation("Assignee", fields: [assigneeId], references: [id])
  assigneeId        String?
  createdBy         User               @relation("Creator", fields: [createdById], references: [id])
  createdById       String
  platformRef       String? // رقم الطلب على المنصة الحكومية
  fee               Decimal?           @db.Decimal(12, 2) // أتعاب المكتب
  govFees           Decimal?           @db.Decimal(12, 2) // الرسوم الحكومية
  dueDate           DateTime?
  priority          TxPriority         @default(NORMAL)
  confidential      Boolean            @default(false) // سرية: للمسؤول عنها ومدير النظام فقط
  acceptedAt        DateTime? // استلام المسؤول الحالي بتعهد (يُصفَّر عند إعادة الإسناد)
  acceptances       TxAcceptance[]
  extensionRequests ExtensionRequest[]
  events            TransactionEvent[]
  quote             Quote?
  documents         Document[]
  deliveries        Delivery[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyId])
  @@index([stageId])
  @@index([assigneeId])
}

// سجل المتابعة: كل تغيير مرحلة أو ملاحظة
model TransactionEvent {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  stage         Stage?      @relation(fields: [stageId], references: [id])
  stageId       String? // لو فيه تغيير مرحلة
  type          TxEventType @default(NOTE)
  external      Boolean     @default(false) // تعليق خارجي موجّه للعميل
  targetUser    User?       @relation("EventTarget", fields: [targetUserId], references: [id])
  targetUserId  String? // الموظف المسند إليه أو الموجّه إليه لفت النظر
  note          String?
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

// إعدادات داخلية (مثلاً: هل تحديث معيّن للبيانات اتطبق قبل كده)
model AppMeta {
  key   String @id
  value String
}

// ======================= المستندات =======================

enum DocType {
  CR // سجل تجاري
  NATIONAL_ID // هوية / إقامة
  BALADY_LICENSE // رخصة بلدي
  NATIONAL_ADDRESS // العنوان الوطني
  ZAKAT_CERT // شهادة الزكاة
  VAT_CERT // شهادة الضريبة
  OTHER_LICENSE // رخصة أخرى
  CONTRACT // عقد موقّع
  PASSPORT // جواز سفر
  WORK_CONTRACT // عقد عمل
  QUALIFICATION // مؤهل علمي / شهادة
  OTHER // أخرى
  CERTIFICATE // شهادة (مخرجات معاملة)
  LETTER // خطاب / إفادة (مخرجات معاملة)
  PAYMENT_RECEIPT // إيصال سداد (مخرجات معاملة)
}

// مستند مرفوع لعميل أو لشركة (واحد منهم بس)
model Document {
  id            String           @id @default(cuid())
  client        Client?          @relation(fields: [clientId], references: [id])
  clientId      String?
  company       Company?         @relation(fields: [companyId], references: [id])
  companyId     String?
  contract      Contract?        @relation(fields: [contractId], references: [id])
  contractId    String?
  employee      Employee?        @relation(fields: [employeeId], references: [id])
  employeeId    String?
  transaction   Transaction?     @relation(fields: [transactionId], references: [id])
  transactionId String? // مخرجات المعاملة
  letter        Letter?          @relation(fields: [letterId], references: [id])
  letterId      String? // مرفقات خطاب صادر أو صورة خطاب وارد
  asset         Asset?           @relation(fields: [assetId], references: [id])
  assetId       String? // فاتورة الأصل أو ضمانه أو صوره
  purchase      PurchaseRequest? @relation(fields: [purchaseId], references: [id])
  purchaseId    String? // عروض الموردين وفاتورة الشراء
  deliveries    Delivery[]       @relation("DeliveryDocuments")
  type          DocType
  title         String? // وصف إضافي (مثلاً: رخصة الدفاع المدني)
  expiresAt     DateTime? // تاريخ الانتهاء
  fileName      String // اسم الملف الأصلي
  mimeType      String
  size          Int
  storageKey    String           @unique // اسم الملف على السيرفر
  uploadedBy    User             @relation(fields: [uploadedById], references: [id])
  uploadedById  String
  createdAt     DateTime         @default(now())

  @@index([clientId])
  @@index([companyId])
  @@index([contractId])
  @@index([employeeId])
  @@index([transactionId])
  @@index([letterId])
  @@index([assetId])
  @@index([purchaseId])
}

// ======================= العقود =======================

enum ContractType {
  ONE_TIME // خدمة واحدة
  MONTHLY // باقة شهرية
  ANNUAL // سنوي
}

model Contract {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  client      Client       @relation(fields: [clientId], references: [id])
  clientId    String
  company     Company?     @relation(fields: [companyId], references: [id])
  companyId   String?
  title       String
  type        ContractType @default(ONE_TIME)
  value       Decimal?     @db.Decimal(12, 2) // القيمة (للباقة: القيمة الشهرية)
  startDate   DateTime
  endDate     DateTime?
  autoRenew   Boolean      @default(false)
  terms       String? // الشروط وطريقة الدفع
  cancelledAt DateTime?
  documents   Document[]
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clientId])
  @@index([endDate])
}

// ======================= سجل التواصل =======================

enum InteractionType {
  CALL // مكالمة
  WHATSAPP // واتساب
  MEETING // اجتماع
  VISIT // زيارة
  EMAIL // إيميل
  OTHER
}

model Interaction {
  id           String          @id @default(cuid())
  client       Client          @relation(fields: [clientId], references: [id])
  clientId     String
  company      Company?        @relation(fields: [companyId], references: [id])
  companyId    String?
  type         InteractionType
  occurredAt   DateTime        @default(now())
  summary      String
  followUpAt   DateTime? // موعد المتابعة
  followUpNote String?
  followUpDone Boolean         @default(false)
  assignee     User?           @relation("FollowUpAssignee", fields: [assigneeId], references: [id])
  assigneeId   String? // مسؤول المتابعة
  createdBy    User            @relation("InteractionCreator", fields: [createdById], references: [id])
  createdById  String
  createdAt    DateTime        @default(now())

  @@index([clientId])
  @@index([followUpAt])
}

// ======================= الصلاحيات =======================

enum PermLevel {
  VIEW // عرض فقط
  EDIT // إضافة وتعديل
  MANAGE // إدارة كاملة
}

// صلاحية مستخدم على قسم
model Permission {
  id      String     @id @default(cuid())
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId  String
  section Department
  level   PermLevel

  @@unique([userId, section])
}

// ======================= الموظفين =======================

enum EmployeeStatus {
  ACTIVE // على رأس العمل
  ON_LEAVE // في إجازة
  SUSPENDED // موقوف
  TERMINATED // انتهت خدمته
}

enum EmploymentType {
  FULL_TIME // دوام كامل
  PART_TIME // دوام جزئي
  TEMPORARY // مؤقت
  TRAINEE // متدرب
}

enum Gender {
  MALE
  FEMALE
}

model Employee {
  id                 String              @id @default(cuid())
  number             Int                 @unique @default(autoincrement()) // الرقم الوظيفي
  user               User?               @relation(fields: [userId], references: [id])
  userId             String?             @unique // حساب الدخول على المنصة
  // البيانات الشخصية
  fullName           String
  fullNameEn         String?
  gender             Gender?
  birthDate          DateTime?
  maritalStatus      String?
  nationality        String?
  // الهوية
  nationalId         String?             @unique // هوية / إقامة
  idExpiry           DateTime?
  passportNumber     String?
  passportExpiry     DateTime?
  // التواصل
  phone              String?
  personalEmail      String?
  city               String?
  address            String?
  emergencyName      String?
  emergencyRelation  String?
  emergencyPhone     String?
  // الوظيفة
  jobTitle           String
  orgDepartment      String? // الإدارة
  manager            Employee?           @relation("Reports", fields: [managerId], references: [id])
  managerId          String?
  reports            Employee[]          @relation("Reports")
  employmentType     EmploymentType      @default(FULL_TIME)
  hireDate           DateTime
  probationEnd       DateTime?
  contractEnd        DateTime?
  workLocation       String?
  status             EmployeeStatus      @default(ACTIVE)
  terminationDate    DateTime?
  terminationReason  String? // RESIGNATION / TERMINATION / CONTRACT_END
  // الراتب
  basicSalary        Decimal?            @db.Decimal(12, 2)
  housingAllowance   Decimal?            @db.Decimal(12, 2)
  transportAllowance Decimal?            @db.Decimal(12, 2)
  otherAllowances    Decimal?            @db.Decimal(12, 2)
  bankName           String?
  iban               String?
  gosiRegistered     Boolean             @default(false)
  notes              String?
  leaveCarryover     Int                 @default(0) // رصيد إجازة سنوية مرحّل (أيام)
  position           Position? // المنصب القيادي اللي بيشغله
  payslips           Payslip[]
  reviews            PerformanceReview[]
  documents          Document[]
  leaveRequests      LeaveRequest[]
  attendance         Attendance[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  custodies Custody[]

  @@index([managerId])
  @@index([status])
}

// ======================= الإجازات والأذونات =======================

enum RequestKind {
  LEAVE // إجازة (أيام)
  PERMISSION // استئذان (ساعات)
}

enum LeaveType {
  ANNUAL // سنوية
  SICK // مرضية
  UNPAID // بدون راتب
  MARRIAGE // زواج
  BEREAVEMENT // وفاة
  PATERNITY // مولود
  MATERNITY // وضع
  HAJJ // حج
  EXAM // امتحانات
  OTHER
}

enum RequestStatus {
  PENDING // بانتظار الموافقة
  APPROVED // معتمد
  REJECTED // مرفوض
  CANCELLED // ملغى
}

model LeaveRequest {
  id           String        @id @default(cuid())
  number       Int           @unique @default(autoincrement())
  employee     Employee      @relation(fields: [employeeId], references: [id])
  employeeId   String
  kind         RequestKind   @default(LEAVE)
  type         LeaveType?
  startDate    DateTime      @db.Date
  endDate      DateTime      @db.Date
  days         Int           @default(0) // أيام العمل المحسوبة
  startTime    String? // للاستئذان HH:MM
  endTime      String?
  minutes      Int?
  reason       String?
  status       RequestStatus @default(PENDING)
  createdBy    User          @relation("RequestCreator", fields: [createdById], references: [id])
  createdById  String
  decidedBy    User?         @relation("RequestDecider", fields: [decidedById], references: [id])
  decidedById  String?
  decidedAt    DateTime?
  decisionNote String?
  createdAt    DateTime      @default(now())

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
}

// العطلات الرسمية
model Holiday {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
}

// ======================= الحضور والانصراف =======================

model Attendance {
  id         String    @id @default(cuid())
  employee   Employee  @relation(fields: [employeeId], references: [id])
  employeeId String
  date       DateTime  @db.Date // اليوم بتوقيت السعودية
  checkIn    DateTime?
  checkOut   DateTime?
  source     String    @default("SELF") // SELF = الموظف نفسه، MANUAL = تعديل يدوي
  note       String?
  editedBy   User?     @relation(fields: [editedById], references: [id])
  editedById String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([employeeId, date])
  @@index([date])
}

// ======================= المناصب القيادية =======================

enum PositionLevel {
  EXECUTIVE // الإدارة التنفيذية العليا
  SENIOR // الإدارة الوسطى العليا (المدير الإداري، المالي...)
  DEPARTMENT // مديرو الأقسام
}

model Position {
  id        String        @id @default(cuid())
  title     String        @unique
  level     PositionLevel @default(DEPARTMENT)
  scope     String? // نطاق المسؤولية
  parent    Position?     @relation("PositionTree", fields: [parentId], references: [id])
  parentId  String? // المنصب الأعلى (يرفع تقاريره إليه)
  children  Position[]    @relation("PositionTree")
  holder    Employee?     @relation(fields: [holderId], references: [id])
  holderId  String?       @unique // الموظف الذي يشغل المنصب
  order     Int           @default(0)
  createdAt DateTime      @default(now())
}

// ======================= مسير الرواتب =======================

enum PayrollStatus {
  DRAFT // مسودة (قابل للتعديل)
  APPROVED // معتمد
  PAID // تم الصرف
}

model PayrollRun {
  id           String        @id @default(cuid())
  month        String        @unique // YYYY-MM
  status       PayrollStatus @default(DRAFT)
  notes        String?
  createdBy    User          @relation("RunCreator", fields: [createdById], references: [id])
  createdById  String
  approvedBy   User?         @relation("RunApprover", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?
  paidAt       DateTime?
  slips        Payslip[]
  createdAt    DateTime      @default(now())
}

model Payslip {
  id                 String     @id @default(cuid())
  run                PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runId              String
  employee           Employee   @relation(fields: [employeeId], references: [id])
  employeeId         String
  paidDays           Int        @default(30) // أيام الاستحقاق (أساس 30 يوماً)
  basic              Decimal    @default(0) @db.Decimal(12, 2)
  housing            Decimal    @default(0) @db.Decimal(12, 2)
  transport          Decimal    @default(0) @db.Decimal(12, 2)
  otherAllowances    Decimal    @default(0) @db.Decimal(12, 2)
  overtime           Decimal    @default(0) @db.Decimal(12, 2) // يدوي
  bonus              Decimal    @default(0) @db.Decimal(12, 2) // يدوي
  absenceDays        Int        @default(0) // غياب + إجازة بدون راتب
  absenceDeduction   Decimal    @default(0) @db.Decimal(12, 2)
  lateMinutes        Int        @default(0)
  lateDeduction      Decimal    @default(0) @db.Decimal(12, 2)
  gosiDeduction      Decimal    @default(0) @db.Decimal(12, 2)
  otherDeduction     Decimal    @default(0) @db.Decimal(12, 2) // يدوي (سلفة مثلاً)
  otherDeductionNote String?
  gross              Decimal    @default(0) @db.Decimal(12, 2)
  totalDeductions    Decimal    @default(0) @db.Decimal(12, 2)
  net                Decimal    @default(0) @db.Decimal(12, 2)
  bankName           String?
  iban               String?
  note               String?

  @@unique([runId, employeeId])
}

// ======================= تقييم الأداء =======================

enum ReviewStatus {
  DRAFT // مسودة
  SUBMITTED // أُرسل للموظف
  ACKNOWLEDGED // اطّلع عليه الموظف
}

model PerformanceReview {
  id              String       @id @default(cuid())
  employee        Employee     @relation(fields: [employeeId], references: [id])
  employeeId      String
  reviewer        User         @relation(fields: [reviewerId], references: [id])
  reviewerId      String
  period          String // مثال: 2026-Q4 أو 2026
  periodStart     DateTime     @db.Date
  periodEnd       DateTime     @db.Date
  scores          Json // درجات المعايير (1 إلى 5)
  overall         Float        @default(0)
  metrics         Json? // مؤشرات تلقائية وقت التقييم
  strengths       String?
  improvements    String?
  goals           String?
  status          ReviewStatus @default(DRAFT)
  employeeComment String?
  submittedAt     DateTime?
  acknowledgedAt  DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@unique([employeeId, period])
}

// ================= عروض الأسعار =================

enum QuoteStatus {
  DRAFT // مسودة
  SENT // أُرسل للعميل
  ACCEPTED // قبله العميل
  REJECTED // رفضه العميل
  CANCELLED // ملغى
}

model Quote {
  id            String       @id @default(cuid())
  number        Int          @unique @default(autoincrement()) // QT-0001
  client        Client       @relation(fields: [clientId], references: [id])
  clientId      String
  company       Company?     @relation(fields: [companyId], references: [id])
  companyId     String?
  title         String
  issueDate     DateTime     @db.Date
  validUntil    DateTime     @db.Date // انتهاء صلاحية العرض
  status        QuoteStatus  @default(DRAFT)
  vatRate       Decimal      @default(15) @db.Decimal(5, 2)
  subtotal      Decimal      @db.Decimal(12, 2) // قبل الضريبة
  vatAmount     Decimal      @db.Decimal(12, 2)
  total         Decimal      @db.Decimal(12, 2)
  govFees       Decimal?     @db.Decimal(12, 2) // الرسوم الحكومية المتوقعة (خارج العرض والفاتورة، بدون ضريبة)
  paymentTerms  String? // طريقة الدفع: دفعة واحدة / أقساط / شهري...
  notes         String? // ملاحظات وشروط تظهر للعميل
  rejectReason  String?
  sentAt        DateTime?
  decidedAt     DateTime? // تاريخ القبول أو الرفض
  transaction   Transaction? @relation(fields: [transactionId], references: [id])
  transactionId String?      @unique // المعاملة الناتجة بعد القبول
  items         QuoteItem[]
  createdBy     User         @relation(fields: [createdById], references: [id])
  createdById   String
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([clientId])
  @@index([status])
}

model QuoteItem {
  id            String       @id @default(cuid())
  quote         Quote        @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  quoteId       String
  order         Int          @default(0)
  description   String
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id])
  serviceTypeId String?
  quantity      Decimal      @default(1) @db.Decimal(10, 2)
  unitPrice     Decimal      @db.Decimal(12, 2)
  lineTotal     Decimal      @db.Decimal(12, 2)

  @@index([quoteId])
}

// طريقة تسليم المخرجات للعميل
enum DeliveryChannel {
  HAND // باليد في المكتب
  WHATSAPP // واتساب
  EMAIL // البريد الإلكتروني
  COURIER // مندوب / شحن
  PLATFORM // عبر المنصة الحكومية
  OTHER
}

// سجل تسليم مخرجات معاملة للعميل (ممكن أكثر من تسليم للمعاملة الواحدة)
model Delivery {
  id             String          @id @default(cuid())
  number         Int             @unique @default(autoincrement()) // DL-0001
  transaction    Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId  String
  deliveredAt    DateTime
  channel        DeliveryChannel
  recipientName  String
  recipientIdNo  String? // هوية المستلم
  recipientPhone String?
  items          String? // أصول ومستندات ورقية مسلَّمة (بند في كل سطر)
  note           String? // رسالة للعميل (تعليق خارجي)
  documents      Document[]      @relation("DeliveryDocuments")
  deliveredBy    User            @relation("DeliveredBy", fields: [deliveredById], references: [id])
  deliveredById  String
  createdAt      DateTime        @default(now())

  @@index([transactionId])
  @@index([deliveredAt])
}

enum TxPriority {
  NORMAL // عادية
  HIGH // مهمة
  URGENT // عاجلة
}

enum TxEventType {
  NOTE // تعليق أو تغيير مرحلة
  ASSIGN // إسناد
  ACCEPT // استلام بتعهد
  EXTENSION // طلب تأجيل أو قرار عليه
  WARNING // لفت نظر
  DELIVERY // تسليم المخرجات
}

// إقرار الموظف باستلام المعاملة ومستنداتها وتعهده بموعد الإنجاز
model TxAcceptance {
  id            String      @id @default(cuid())
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  user          User        @relation(fields: [userId], references: [id])
  userId        String
  jobTitle      String? // صفة الموظف وقت الإقرار
  committedDue  DateTime // الموعد الذي تعهّد بالإنجاز قبله
  documents     String? // المستندات والأصول المستلمة من العميل
  pledgeText    String // نص الإقرار كما وافق عليه
  createdAt     DateTime    @default(now())

  @@index([transactionId])
}

enum ExtensionStatus {
  PENDING
  APPROVED
  REJECTED
}

// طلب تأجيل موعد إنجاز المعاملة
model ExtensionRequest {
  id            String          @id @default(cuid())
  transaction   Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionId String
  requestedBy   User            @relation("ExtensionRequester", fields: [requestedById], references: [id])
  requestedById String
  currentDue    DateTime?
  requestedDue  DateTime
  reason        String
  status        ExtensionStatus @default(PENDING)
  decidedBy     User?           @relation("ExtensionDecider", fields: [decidedById], references: [id])
  decidedById   String?
  decidedAt     DateTime?
  decisionNote  String?
  createdAt     DateTime        @default(now())

  @@index([transactionId])
  @@index([status])
}

enum LetterDirection {
  OUTGOING // صادر
  INCOMING // وارد
}

enum LetterStatus {
  DRAFT // مسودة
  IN_REVIEW // بانتظار المراجعة
  REVIEWED // تمت المراجعة، بانتظار الاعتماد
  RETURNED // أُعيد للتعديل
  APPROVED // معتمد (صادر) — له رقم صادر ورمز تحقق
  RECEIVED // مسجَّل (وارد)
  CANCELLED // ملغى
}

// الصادر والوارد
model Letter {
  id           String          @id @default(cuid())
  direction    LetterDirection
  year         Int? // سنة الترقيم
  seq          Int? // الرقم داخل السنة (الصادر عند الاعتماد، الوارد عند التسجيل)
  status       LetterStatus
  subject      String
  body         String? // نص الخطاب الصادر، أو ملخص الوارد
  party        String // الصادر: الجهة الموجّه إليها — الوارد: الجهة المرسلة
  partyRef     String? // رقم خطاب الجهة المرسلة (الوارد) أو رقم مرجعي
  letterDate   DateTime?       @db.Date // تاريخ الخطاب: الصادر = تاريخ الاعتماد، الوارد = التاريخ المدوّن عليه
  receivedAt   DateTime?       @db.Date // تاريخ استلام الوارد
  hideLogo     Boolean         @default(false)
  client       Client?         @relation(fields: [clientId], references: [id])
  clientId     String?
  createdBy    User            @relation("LetterCreator", fields: [createdById], references: [id])
  createdById  String
  reviewedBy   User?           @relation("LetterReviewer", fields: [reviewedById], references: [id])
  reviewedById String?
  reviewedAt   DateTime?
  approvedBy   User?           @relation("LetterApprover", fields: [approvedById], references: [id])
  approvedById String?
  approvedAt   DateTime?
  assignee     User?           @relation("LetterAssignee", fields: [assigneeId], references: [id])
  assigneeId   String? // الوارد: الموظف المحال إليه
  actionDone   Boolean         @default(false) // الوارد: تم الإجراء
  verifyToken  String?         @unique // رمز صفحة التحقق العامة (QR)
  documents    Document[]
  events       LetterEvent[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([direction, year, seq])
  @@index([status])
  @@index([clientId])
}

// سجل الخطاب (إنشاء، إرسال للمراجعة، تصديق، إعادة، اعتماد، إحالة، إلغاء)
model LetterEvent {
  id        String   @id @default(cuid())
  letter    Letter   @relation(fields: [letterId], references: [id], onDelete: Cascade)
  letterId  String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  note      String
  createdAt DateTime @default(now())

  @@index([letterId])
}

// قوالب الخطابات الجاهزة
model LetterTemplate {
  id      String  @id @default(cuid())
  name    String  @unique
  subject String?
  body    String
  active  Boolean @default(true)
  order   Int     @default(0)
}

enum AssetStatus {
  AVAILABLE // متاح
  IN_CUSTODY // في عهدة موظف
  MAINTENANCE // في الصيانة
  RETIRED // مستبعد / تالف
  LOST // مفقود
}

enum CustodyStatus {
  PENDING // بانتظار إقرار الموظف بالاستلام
  ACTIVE // عهدة قائمة (أقرّ الموظف أو وُقّع النموذج ورقياً)
  RETURNED // أُعيدت
}

model AssetCategory {
  id            String         @id @default(cuid())
  name          String         @unique
  order         Int            @default(0)
  active        Boolean        @default(true)
  assets        Asset[]
  purchaseItems PurchaseItem[]
}

// أصول المنشأة (AST-0001)
model Asset {
  id            String           @id @default(cuid())
  number        Int              @unique @default(autoincrement())
  name          String
  category      AssetCategory    @relation(fields: [categoryId], references: [id])
  categoryId    String
  brand         String? // الماركة / الموديل
  serialNumber  String? // الرقم التسلسلي أو رقم اللوحة
  location      String? // الموقع (المكتب، الفرع…)
  purchaseDate  DateTime?        @db.Date
  purchasePrice Decimal?         @db.Decimal(12, 2)
  supplier      String?
  warrantyEnd   DateTime?        @db.Date
  status        AssetStatus      @default(AVAILABLE)
  notes         String?
  createdBy     User             @relation("AssetCreator", fields: [createdById], references: [id])
  createdById   String
  custodies     Custody[]
  documents     Document[]
  purchase      PurchaseRequest? @relation(fields: [purchaseId], references: [id])
  purchaseId    String? // طلب الشراء الذي أُنشئ منه الأصل
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([status])
  @@index([categoryId])
}

// عهدة: تسليم أصل لموظف، وإقراره بالاستلام، ثم إعادته
model Custody {
  id             String        @id @default(cuid())
  asset          Asset         @relation(fields: [assetId], references: [id])
  assetId        String
  employee       Employee      @relation(fields: [employeeId], references: [id])
  employeeId     String
  status         CustodyStatus @default(PENDING)
  assignedAt     DateTime      @default(now())
  assignedBy     User          @relation("CustodyAssigner", fields: [assignedById], references: [id])
  assignedById   String
  conditionOut   String? // حالة الأصل عند التسليم
  note           String?
  acknowledgedAt DateTime?
  ackMethod      String? // PLATFORM = أقرّ الموظف بنفسه، PAPER = نموذج موقّع ورقياً
  ackText        String? // نص الإقرار كما وافق عليه
  returnedAt     DateTime?
  conditionIn    String? // حالة الأصل عند الإعادة
  returnNote     String?
  receivedBy     User?         @relation("CustodyReceiver", fields: [receivedById], references: [id])
  receivedById   String?

  @@index([assetId])
  @@index([employeeId])
  @@index([status])
}

// الموردون
model Supplier {
  id          String            @id @default(cuid())
  name        String            @unique
  category    String? // نوع التوريد: أجهزة، أثاث، قرطاسية…
  contactName String?
  phone       String?
  email       String?
  city        String?
  crNumber    String?
  vatNumber   String?
  iban        String?
  notes       String?
  active      Boolean           @default(true)
  quotes      SupplierQuote[]
  purchases   PurchaseRequest[]
  createdAt   DateTime          @default(now())
}

enum PurchaseStatus {
  PENDING_MANAGER // بانتظار موافقة المدير المباشر
  PENDING_APPROVAL // بانتظار اعتماد الشؤون الإدارية
  APPROVED // معتمد — جاهز للشراء
  RECEIVED // تم الشراء والاستلام
  REJECTED
  CANCELLED
}

// طلب شراء (PUR-0001)
model PurchaseRequest {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement())
  title         String
  justification String // سبب الحاجة
  neededBy      DateTime?       @db.Date
  status        PurchaseStatus
  requestedBy   User            @relation("PurchaseRequester", fields: [requestedById], references: [id])
  requestedById String
  managerBy     User?           @relation("PurchaseManager", fields: [managerById], references: [id])
  managerById   String?
  managerAt     DateTime?
  approvedBy    User?           @relation("PurchaseApprover", fields: [approvedById], references: [id])
  approvedById  String?
  approvedAt    DateTime?
  rejectReason  String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id])
  supplierId    String? // المورد الذي تم الشراء منه
  invoiceNumber String?
  totalActual   Decimal?        @db.Decimal(12, 2) // الإجمالي الفعلي شامل الضريبة
  receivedAt    DateTime?       @db.Date
  receivedBy    User?           @relation("PurchaseReceiver", fields: [receivedById], references: [id])
  receivedById  String?
  items         PurchaseItem[]
  quotes        SupplierQuote[]
  documents     Document[]
  assets        Asset[]
  events        PurchaseEvent[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([requestedById])
}

model PurchaseItem {
  id           String          @id @default(cuid())
  purchase     PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId   String
  order        Int             @default(0)
  description  String
  quantity     Int             @default(1)
  estUnitPrice Decimal?        @db.Decimal(12, 2) // السعر التقديري للوحدة
  isAsset      Boolean         @default(false) // يُضاف لسجل الأصول عند الاستلام
  category     AssetCategory?  @relation(fields: [categoryId], references: [id])
  categoryId   String?
}

// عرض سعر من مورد على طلب شراء (اختياري)
model SupplierQuote {
  id         String          @id @default(cuid())
  purchase   PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  supplier   Supplier        @relation(fields: [supplierId], references: [id])
  supplierId String
  amount     Decimal         @db.Decimal(12, 2) // الإجمالي شامل الضريبة
  notes      String?
  selected   Boolean         @default(false)
  createdAt  DateTime        @default(now())

  @@index([purchaseId])
}

model PurchaseEvent {
  id         String          @id @default(cuid())
  purchase   PurchaseRequest @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  purchaseId String
  user       User            @relation(fields: [userId], references: [id])
  userId     String
  note       String
  createdAt  DateTime        @default(now())

  @@index([purchaseId])
}
